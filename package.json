{
  "name": "larp-code",
  "version": "0.1.0",
  "private": true,
  "description": "The larp-code popup-only Chrome extension foundation.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --no-file-parallelism",
    "acceptance:invitation": "node scripts/invitation-lifecycle-acceptance.mjs",
    "test:watch": "vitest",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:reset": "supabase db reset",
    "backend:status": "supabase status",
    "package:check": "node scripts/check-package.mjs",
    "recovery:rehearse": "node scripts/rehearse-recovery.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm package:check",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/chrome": "^0.2.6",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "puppeteer-core": "^25.7.0",
    "supabase": "^2.114.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
