# Transactional product mail is the only mail sent by the product outbox.
# Keep this false in every deployment; the edge adapter rejects true.
TRANSACTIONAL_TRACKING=false

# Local automated capture uses Mailpit. Production uses the Resend adapter.
TRANSACTIONAL_MAIL_TRANSPORT=mailpit
MAILPIT_URL=http://127.0.0.1:54324
TRANSACTIONAL_FROM_EMAIL=larp-code <notice@auth.larp-code.example>
# RESEND_API_KEY=replace-in-the-deployment-secret-store

# The scheduler calls dispatch-transactional-notice with this secret.
# TRANSACTIONAL_DISPATCH_SECRET=replace-in-the-deployment-secret-store
